# Taskora Environment Variables Example
# Copy this file to .env and replace placeholders with real keys when connecting production services.

# Frontend Host & Port
VITE_PORT=5173
VITE_HOST=localhost

# API Base URL (leave empty to use local mock API storage layer)
VITE_API_BASE_URL=

# AI Provider Gateway (Optional: server-side only in real deployment, NEVER exposed in client)
AI_API_KEY=your_gemini_or_openai_api_key_placeholder
AI_MODEL_NAME=gemini-2.0-flash

# Database Configuration (for upcoming Node.js / Prisma backend)
DATABASE_URL=postgresql://taskora_user:password_placeholder@localhost:5432/taskora_db?schema=public

# JWT Secret & Session Encryption
JWT_SECRET=super_secret_jwt_encryption_key_placeholder
SESSION_SECRET=taskora_session_secret_cookie_placeholder
