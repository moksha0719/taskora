# Copy this file to .env and replace the password with a unique local value.
# Compose constructs the backend DATABASE_URL from these values; use a URL-safe password.
POSTGRES_DB=taskora_db
POSTGRES_USER=taskora_user
POSTGRES_PASSWORD=replace_with_a_unique_local_password

# The backend container reaches PostgreSQL at hostname "postgres".
DATABASE_URL=postgresql://taskora_user:replace_with_a_unique_local_password@postgres:5432/taskora_db?schema=public
