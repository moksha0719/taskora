generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StudyDayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ScheduleItemKind {
  STUDY
  REVIEW
}

enum NotificationType {
  TASK_DUE           @map("task_due")
  TASK_COMPLETED     @map("task_completed")
  STUDY_REMINDER     @map("study_reminder")
  STUDY_PLAN_UPDATED @map("study_plan_updated")
  SYSTEM             @map("system")
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantActionType {
  CREATE_TASK
}

enum ActionProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String // Store password hashes only.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  studyPlans     StudyPlan[]
  notifications Notification[]
  aiConversations AiConversation[]
  brainDumps BrainDump[]
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id])
  notifications Notification[]
  assistantProposals AssistantProposal[]
  brainDumpProposals BrainDumpTaskProposal[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model StudyPlan {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @db.Uuid
  activeUserId         String?         @unique @db.Uuid // Set to userId only while ACTIVE; a database check enforces this.
  title                String
  status               StudyPlanStatus @default(DRAFT)
  startDate            DateTime        @db.Date
  endDate              DateTime        @db.Date
  timeZone             String          @default("Asia/Colombo") @db.VarChar(64)
  weeklyTargetMinutes  Int
  studyDaysPerWeek     Int
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notifications         Notification[]
  subjects             StudySubject[]

  @@index([userId, status])
}

model StudySubject {
  id                    String          @id @default(uuid()) @db.Uuid
  planId                String          @db.Uuid
  name                  String
  code                  String
  color                 String          @db.VarChar(7)
  targetMinutesPerWeek  Int
  plan                  StudyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleItems         ScheduleItem[]

  @@index([planId])
}

model ScheduleItem {
  id                String              @id @default(uuid()) @db.Uuid
  subjectId         String              @db.Uuid
  dayOfWeek         StudyDayOfWeek
  startMinuteOfDay  Int
  durationMinutes   Int
  kind              ScheduleItemKind    @default(STUDY)
  topics            String[]            @default([]) // Required; the migration also enforces NOT NULL.
  subject           StudySubject        @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  completions       SessionCompletion[]
  notifications     Notification[]

  @@index([subjectId, dayOfWeek])
}

model SessionCompletion {
  id                    String       @id @default(uuid()) @db.Uuid
  scheduleItemId        String       @db.Uuid
  occurrenceDate        DateTime     @db.Date
  completedAt           DateTime     @default(now())
  actualDurationMinutes Int? // Optional; the migration requires a positive value when set.
  scheduleItem          ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([scheduleItemId, occurrenceDate])
  @@index([occurrenceDate])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  message         String
  actionUrl       String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  dedupeKey       String?          @unique
  taskId          String?          @db.Uuid
  studyPlanId     String?          @db.Uuid
  scheduleItemId  String?          @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studyPlan       StudyPlan?       @relation(fields: [studyPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scheduleItem    ScheduleItem?    @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
}

model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  title     String?     @db.VarChar(160)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages  AiMessage[]
  proposals AssistantProposal[]

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

model AiMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @db.Uuid
  userId         String                @db.Uuid
  role           AssistantMessageRole
  content        String                @db.VarChar(4000)
  createdAt      DateTime              @default(now())
  conversation   AiConversation        @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, conversationId, createdAt])
}

model AssistantProposal {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @db.Uuid
  userId         String               @db.Uuid
  actionType     AssistantActionType
  payload        Json
  status         ActionProposalStatus @default(PENDING)
  expiresAt      DateTime
  resolvedAt     DateTime?
  approvedTaskId String?              @unique @db.Uuid
  createdAt      DateTime             @default(now())
  conversation   AiConversation      @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  approvedTask   Task?                @relation(fields: [approvedTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, status, createdAt])
}

model BrainDump {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  inputText String                 @db.VarChar(8000)
  summary   String                 @db.VarChar(500)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  proposals BrainDumpTaskProposal[]

  @@unique([id, userId])
  @@index([userId, createdAt])
}

model BrainDumpTaskProposal {
  id             String               @id @default(uuid()) @db.Uuid
  brainDumpId    String               @db.Uuid
  userId         String               @db.Uuid
  title          String               @db.VarChar(120)
  description    String?              @db.VarChar(1000)
  priority       TaskPriority
  dueDate        DateTime?
  status         ActionProposalStatus @default(PENDING)
  resolvedAt     DateTime?
  approvedTaskId String?              @unique @db.Uuid
  createdAt      DateTime             @default(now())
  brainDump      BrainDump            @relation(fields: [brainDumpId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  approvedTask   Task?                @relation(fields: [approvedTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, status, createdAt])
}
